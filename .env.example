# Required for the web configuration form. Use a long random value (32+ bytes recommended).
CONFIG_SECRET=replace-with-a-long-random-secret

# Optional environment fallbacks. You do not need these when using the web configuration form.
SKT_UID=
SKT_PASS=
TORBOX_API_KEY=
TMDB_API_KEY=

# Optional runtime tuning
MOVIE_SEARCH_PAGES=6
SERIES_SEARCH_PAGES=10
MAX_TORRENTS_TO_INSPECT=24
TORRENT_FETCH_CONCURRENCY=4
CACHE_TTL_MS=600000
HTTP_TIMEOUT_MS=8000
TORBOX_DIRECT_LINKS=true
TORBOX_MAX_DIRECT_LINKS=5
